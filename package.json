{
  "name": "conversio-experiences",
  "version": "0.1.0",
  "description": "Shared framework for Conversio CRO experiences: scaffolding, build tooling, local tester, and reusable helpers.",
  "private": true,
  "workspaces": [
    "packages/helpers",
    "packages/tester"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/helpers",
    "scaffold": "node scripts/scaffold.js",
    "build:experience": "node scripts/build.js",
    "tester": "node packages/tester/bin/tester",
    "postinstall": "npm run build"
  },
  "devDependencies": {
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "babel-loader": "^9.1.3",
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "sass-loader": "^13.3.2",
    "sass": "^1.49.9",
    "postcss-loader": "^7.3.3",
    "postcss": "^8.4.31",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "puppeteer": "25.1.0",
    "chokidar": "^3.5.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
